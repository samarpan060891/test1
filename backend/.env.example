PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/qc_inspection
# Generate with: openssl rand -hex 32  — never use a guessable value in production
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h
NODE_ENV=development

# Email (Resend)
RESEND_API_KEY=
# Verified sender for production, e.g. "QC Portal <qc@yourdomain.com>"
EMAIL_FROM=
# Optional comma-separated CC list applied to all outgoing mail
EMAIL_CC=
# When set, all emails are redirected to this address (test mode)
TEST_EMAIL_TO=

# Public URL of the frontend, used in email links
APP_URL=
# Comma-separated additional allowed CORS origins
CORS_ORIGIN=
